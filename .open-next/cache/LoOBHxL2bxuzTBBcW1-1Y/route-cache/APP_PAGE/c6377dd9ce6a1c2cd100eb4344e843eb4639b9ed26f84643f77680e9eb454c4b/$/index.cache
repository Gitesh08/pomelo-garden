309\" stroke=\"#141715\" stroke-width=\"1.6\"></ellipse><ellipse cx=\"34\" cy=\"35\" rx=\"13.5\" ry=\"3.5\" fill=\"url(#mob-card-sunset-solkadhiLiquid)\" stroke=\"#BD4335\" stroke-width=\"1\"></ellipse><ellipse cx=\"28\" cy=\"34\" rx=\"3.5\" ry=\"1.4\" fill=\"#FFFFFF\" opacity=\"0.9\"></ellipse><path d=\"M40 31 C43 23, 50 25, 48 32 Z\" fill=\"#65A30D\" stroke=\"#141715\" stroke-width=\"1\"></path></g></svg></div></div><div><span class=\"text-[10px] font-mono uppercase tracking-widest text-[#788E73] font-bold block mb-0.5\">Golden Hour Solkadhi &amp; High Tea</span><h4 class=\"font-serif text-xs font-bold text-[#141715] line-clamp-2 leading-snug\">Chilled Pink Kokum Solkadhi &amp; Ridge Sunset</h4></div></button><button type=\"button\" class=\"snap-start w-[210px] shrink-0 p-3.5 rounded-2xl text-left transition-all duration-200 border flex flex-col justify-between bg-[#F2EDE2]/70 border-[rgba(139,130,88,0.22)]\"><div class=\"flex items-center justify-between gap-1 w-full mb-2\"><span class=\"font-mono text-[11px] font-bold text-[#141715] px-2 py-0.5 rounded-full bg-white border border-[rgba(139,130,88,0.2)]\">08:30 PM</span><div class=\"shrink-0 flex items-center justify-center\"><svg viewBox=\"0 0 100 80\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-16 h-14 sm:w-20 sm:h-16 transition-all duration-300 drop-shadow-sm select-none\" aria-hidden=\"true\"><defs><linearGradient id=\"mob-card-night-fireOuter\" x1=\"0%\" y1=\"100%\" x2=\"0%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#B91C1C\"></stop><stop offset=\"40%\" stop-color=\"#EA580C\"></stop><stop offset=\"85%\" stop-color=\"#F59E0B\"></stop><stop offset=\"100%\" stop-color=\"#FDE047\"></stop></linearGradient><linearGradient id=\"mob-card-night-fireInner\" x1=\"0%\" y1=\"100%\" x2=\"0%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#F59E0B\"></stop><stop offset=\"60%\" stop-color=\"#FDE047\"></stop><stop offset=\"100%\" stop-color=\"#FFFFFF\"></stop></linearGradient></defs><style>\n              @keyframes flameFlickering {\n                0%, 100% { transform: scale(1) rotate(0deg); }\n                25% { transform: scale(1.04, 0.97) rotate(-1.5deg); }\n                50% { transform: scale(0.97, 1.05) rotate(1.5deg); }\n                75% { transform: scale(1.02, 1.01) rotate(-0.5deg); }\n              }\n              @keyframes starTwinkling {\n                0%, 100% { opacity: 0.35; transform: scale(0.85); }\n                50% { opacity: 1; transform: scale(1.25); }\n              }\n              @keyframes emberFloating {\n                0% { transform: translate(0, 0); opacity: 0.9; }\n                50% { transform: translate(-3px, -8px); opacity: 1; }\n                100% { transform: translate(2px, -18px); opacity: 0; }\n              }\n              .anim-flame { transform-origin: 50px 60px; animation: flameFlickering 2.2s ease-in-out infinite; }\n              .anim-star-1 { transform-origin: 22px 14px; animation: starTwinkling 2.5s ease-in-out infinite; }\n              .anim-star-2 { transform-origin: 40px 10px; animation: starTwinkling 3.2s ease-in-out infinite 0.8s; }\n              .anim-star-3 { transform-origin: 82px 16px; animation: starTwinkling 2.8s ease-in-out infinite 1.4s; }\n              .anim-ember-1 { animation: emberFloating 2.8s ease-in-out infinite; }\n              .anim-ember-2 { animation: emberFloating 3.2s ease-in-out infinite 1.1s; }\n            </style><path d=\"M66 10 C61 10, 56 14, 56 20 C56 26, 61 30, 68 30 C65 32, 61 32, 58 31 C53 29, 50 23, 51 18 C52 13, 58 9, 66 10 Z\" fill=\"#FDE047\" stroke=\"#CA8A04\" stroke-width=\"0.8\"></path><g><circle cx=\"22\" cy=\"14\" r=\"1.8\" fill=\"#FFFFFF\" class=\"anim-star-1\"></circle><circle cx=\"40\" cy=\"10\" r=\"1.5\" fill=\"#FEF08A\" class=\"anim-star-2\"></circle><circle cx=\"82\" cy=\"16\" r=\"1.8\" fill=\"#FFFFFF\" class=\"anim-star-3\"></circle><circle cx=\"30\" cy=\"24\" r=\"1.2\" fill=\"#FFFFFF\" opacity=\"0.75\"></circle><circle cx=\"88\" cy=\"28\" r=\"1.2\" fill=\"#FEF08A\" opacity=\"0.75\"></circle></g><g><rect x=\"18\" y=\"58\" width=\"64\" height=\"10\" rx=\"5\" transform=\"rotate(-15 50 63)\" fill=\"#78350F\" stroke=\"#141715\" stroke-width=\"1.8\"></rect><rect x=\"18\" y=\"58\" width=\"64\" height=\"10\" rx=\"5\" transform=\"rotate(15 50 63)\" fill=\"#92400E\" stroke=\"#141715\" stroke-width=\"1.8\"></rect><circle cx=\"24\" cy=\"61\" r=\"3.2\" fill=\"#B45309\" stroke=\"#141715\" stroke-width=\"1\"></circle><circle cx=\"24\" cy=\"61\" r=\"1.5\" fill=\"#78350F\"></circle></g><circle cx=\"44\" cy=\"64\" r=\"2.8\" fill=\"#F59E0B\"></circle><circle cx=\"56\" cy=\"63\" r=\"3\" fill=\"#EF4444\"></circle><circle cx=\"50\" cy=\"62\" r=\"3.5\" fill=\"#FDE047\"></circle><g class=\"anim-flame\"><path d=\"M50 20 C57 32, 70 40, 67 56 C64 64, 57 66, 50 66 C43 66, 36 64, 33 56 C30 40, 43 32, 50 20 Z\" fill=\"url(#mob-card-night-fireOuter)\" stroke=\"#141715\" stroke-width=\"1.6\"></path><path d=\"M50 32 C55 40, 63 46, 61 58 C59 63, 55 64, 50 64 C45 64, 41 63, 39 58 C37 46, 45 40, 50 32 Z\" fill=\"url(#mob-card-night-fireInner)\"></path><path d=\"M50 44 C53 49, 57 53, 56 60 C55 63, 52 63.5, 50 63.5 C48 63.5, 45 63, 44 60 C43 53, 47 49, 50 44 Z\" fill=\"#FFFFFF\"></path></g><circle cx=\"44\" cy=\"30\" r=\"1.5\" fill=\"#F59E0B\" class=\"anim-ember-1\"></circle><circle cx=\"58\" cy=\"26\" r=\"1.6\" fill=\"#EF4444\" class=\"anim-ember-2\"></circle></svg></div></div><div><span class=\"text-[10px] font-mono uppercase tracking-widest text-[#788E73] font-bold block mb-0.5\">Sahyadri Bonfire &amp; Starlit Feast</span><h4 class=\"font-serif text-xs font-bold text-[#141715] line-clamp-2 leading-snug\">Acoustic Cedar Wood Fire &amp; Night Stargazing</h4></div></button></div></div><div class=\"bg-white rounded-3xl p-6 sm:p-10 border border-[rgba(139,130,88,0.25)] shadow-md grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center\"><div class=\"lg:col-span-8 space-y-4\"><div class=\"flex flex-wrap items-center gap-2.5 sm:gap-3\"><span class=\"px-3.5 py-1 rounded-full text-xs font-mono font-bold bg-[#141715] text-[#FAF8F3]\">06:30 AM</span><span class=\"px-3 py-1 rounded-full text-xs font-mono uppercase tracking-wider font-semibold border bg-[#7BA23F]/15 text-[#5A7E24] border-[#7BA23F]/30\">Dewdrops &amp; Morning Lemongrass Tea</span></div><h3 class=\"font-serif text-2xl sm:text-3xl lg:text-4xl text-[#141715] leading-tight font-bold\">Sunrise Birdcalls &amp; Misty Citrus Groves</h3><p class=\"text-xs sm:text-sm text-[#56635A] leading-relaxed max-w-2xl font-sans\">Awaken naturally as Sahyadri mountain mists gently part across 12 acres of tranquil citrus groves. Walk unhurried earthen pathways with sweet-scented pomelo blossoms, accompanied by melodious bulbul birdcalls and freshly clipped lemongrass tea.</p><div class=\"p-3.5 sm:p-4 rounded-xl bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] flex items-start gap-3 text-xs text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles lucide-stars w-4 h-4 text-[#7BA23F] shrink-0 mt-0.5\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg><div><span class=\"font-bold text-[#141715] block font-mono text-[11px] uppercase tracking-wider mb-0.5\">Orchard Sensory Detail</span><span class=\"leading-relaxed\">Cool morning dewdrops on citrus leaves and wild lemongrass tea warming in your hands.</span></div></div></div><div class=\"lg:col-span-4 flex flex-col items-center justify-center p-6 sm:p-8 rounded-2xl bg-[#F2EDE2]/70 border border-[rgba(139,130,88,0.2)] text-center space-y-3\"><div class=\"p-4 sm:p-6 rounded-2xl bg-white shadow-sm border border-[rgba(139,130,88,0.2)] flex items-center justify-center\"><svg viewBox=\"0 0 100 80\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-28 h-24 sm:w-32 sm:h-28 transition-all duration-300 drop-shadow-sm select-none\" aria-hidden=\"true\"><defs><linearGradient id=\"showcase-dawnSun\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#FEF08A\"></stop><stop offset=\"40%\" stop-color=\"#FBBF24\"></stop><stop offset=\"85%\" stop-color=\"#F97316\"></stop><stop offset=\"100%\" stop-color=\"#EA580C\"></stop></linearGradient><radialGradient id=\"showcase-dawnGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\"><stop offset=\"0%\" stop-color=\"#FDE047\" stop-opacity=\"0.5\"></stop><stop offset=\"70%\" stop-color=\"#F59E0B\" stop-opacity=\"0.15\"></stop><stop offset=\"100%\" stop-color=\"#F59E0B\" stop-opacity=\"0\"></stop></radialGradient><linearGradient id=\"showcase-dawnLeaf\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#84CC16\"></stop><stop offset=\"100%\" stop-color=\"#4D7C0F\"></stop></linearGradient></defs><style>\n              @keyframes dawnSunPulse {\n                0%, 100% { transform: scale(1); opacity: 0.95; }\n                50% { transform: scale(1.06); opacity: 1; }\n              }\n              @keyframes birdGliding {\n                0%, 100% { transform: translate(0, 0); }\n                50% { transform: translate(3px, -2px); }\n              }\n              @keyframes mistDrift {\n                0%, 100% { transform: translateX(0); opacity: 0.5; }\n                50% { transform: translateX(4px); opacity: 0.75; }\n              }\n              .anim-dawn-sun { transform-origin: 50px 32px; animation: dawnSunPulse 3.5s ease-in-out infinite; }\n              .anim-bird { animation: birdGliding 4s ease-in-out infinite; }\n              .anim-mist { animation: mistDrift 6s ease-in-out infinite; }\n            </style><circle cx=\"50\" cy=\"32\" r=\"28\" fill=\"url(#showcase-dawnGlow)\" class=\"anim-dawn-sun\"></circle><g stroke=\"#F59E0B\" stroke-width=\"1.8\" stroke-linecap=\"round\" opacity=\"0.85\"><line x1=\"50\" y1=\"8\" x2=\"50\" y2=\"14\"></line><line x1=\"33\" y1=\"15\" x2=\"37\" y2=\"19\"></line><line x1=\"67\" y1=\"15\" x2=\"63\" y2=\"19\"></line><line x1=\"26\" y1=\"32\" x2=\"20\" y2=\"32\"></line><line x1=\"74\" y1=\"32\" x2=\"80\" y2=\"32\"></line></g><circle cx=\"50\" cy=\"32\" r=\"16\" fill=\"url(#showcase-dawnSun)\" stroke=\"#EA580C\" stroke-width=\"1.2\" class=\"anim-dawn-sun\"></circle><circle cx=\"50\" cy=\"32\" r=\"19\" stroke=\"#FEF08A\" stroke-width=\"1\" stroke-dasharray=\"3 3\" opacity=\"0.7\"></circle><path d=\"M5 56 C20 46, 38 48, 52 42 C66 36, 80 48, 95 44\" stroke=\"#8B8258\" stroke-width=\"2.2\" stroke-linecap=\"round\" class=\"anim-mist\"></path><path d=\"M12 62 C28 54, 46 56, 62 50 C76 46, 86 54, 94 52\" stroke=\"#A89B6C\" stroke-width=\"1.5\" stroke-linecap=\"round\" opacity=\"0.6\"></path><path d=\"M10 60 C26 50, 42 46, 68 44\" stroke=\"#6B5E43\" stroke-width=\"2.4\" stroke-linecap=\"round\"></path><path d=\"M24 54 C20 42, 34 38, 42 44 C36 56, 26 56, 24 54 Z\" fill=\"url(#showcase-dawnLeaf)\" stroke=\"#141715\" stroke-width=\"1.4\"></path><path d=\"M26 53 C31 47, 38 44, 41 44\" stroke=\"#FAF8F3\" stroke-width=\"1\" stroke-linecap=\"round\" opacity=\"0.8\"></path><circle cx=\"48\" cy=\"53\" r=\"6.5\" fill=\"#7BA23F\" stroke=\"#3F6212\" stroke-width=\"1.4\"></circle><ellipse cx=\"46.5\" cy=\"51\" rx=\"1.8\" ry=\"1\" fill=\"#FFFFFF\" opacity=\"0.6\"></ellipse><circle cx=\"36\" cy=\"46\" r=\"1.5\" fill=\"#FFFFFF\"></circle><g class=\"anim-bird\"><path d=\"M62 20 C64 16, 68 17, 71 20 C73 17, 77 16, 80 20\" stroke=\"#141715\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M74 13 C75 10, 78 11, 80 13 C82 11, 85 10, 87 13\" stroke=\"#141715\" stroke-width=\"1.2\" stroke-linecap=\"round\" opacity=\"0.8\"></path></g></svg></div><div><span class=\"font-serif text-base sm:text-lg font-bold text-[#141715] block\">Dawn Orchard Stroll</span><span class=\"text-[11px] font-mono text-[#788E73]\">06:30 AM<!-- --> • Saphale Foothills</span></div></div></div></div></section><section class=\"py-12 sm:py-16 bg-[#FAF8F3] border-y border-[rgba(139,130,88,0.2)] relative overflow-hidden\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"text-center max-w-xl mx-auto mb-10 sm:mb-12 space-y-2\"><span class=\"text-[11px] font-mono uppercase tracking-widest font-bold text-[#788E73] block\">Resort Inclusions</span><h2 class=\"font-serif text-3xl sm:text-4xl text-[#141715] tracking-tight\">Thoughtful Orchard Amenities</h2><p class=\"text-xs sm:text-sm text-[#56635A] max-w-md mx-auto leading-relaxed\">Everything you need for an unhurried, comfortable stay amidst 12 acres of tranquil greenery.</p></div><div class=\"hidden lg:grid lg:grid-cols-8 divide-x divide-dashed divide-[rgba(139,130,88,0.28)] bg-white/70 rounded-2xl border border-[rgba(139,130,88,0.2)] shadow-xs py-6 px-2\"><div class=\"group px-3 py-2 text-center flex flex-col items-center justify-between transition-all duration-300 hover:-translate-y-1 cursor-default\"><div class=\"mb-3 flex items-center justify-center min-h-[50px]\"><svg viewBox=\"0 0 64 56\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-12 h-11 mx-auto transition-transform duration-300 group-hover:scale-110\" aria-hidden=\"true\"><defs><linearGradient id=\"desk-poolSun\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#FEF08A\"></stop><stop offset=\"40%\" stop-color=\"#FBBF24\"></stop><stop offset=\"100%\" stop-color=\"#F97316\"></stop></linearGradient><linearGradient id=\"desk-waveGrad1\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#38BDF8\"></stop><stop offset=\"50%\" stop-color=\"#2563EB\"></stop><stop offset=\"100%\" stop-color=\"#1D4ED8\"></stop></linearGr