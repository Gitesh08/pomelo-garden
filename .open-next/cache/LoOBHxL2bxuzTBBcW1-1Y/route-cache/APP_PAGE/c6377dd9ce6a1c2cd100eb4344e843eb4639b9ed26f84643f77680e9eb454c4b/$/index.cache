olors shrink-0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><button type=\"button\" class=\"px-8 py-3.5 rounded-xl bg-[#141715] hover:bg-[#28302b] text-[#FAF8F3] text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 transition-all shadow-md hover:shadow-lg cursor-pointer shrink-0\"><span>Check Rates</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-[#E06354]\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></div><div class=\"md:hidden bg-white/95 backdrop-blur-md rounded-2xl border border-[rgba(139,130,88,0.22)] shadow-xl p-3 flex flex-col gap-2.5\"><div class=\"grid grid-cols-2 gap-2\"><button type=\"button\" class=\"p-2.5 rounded-xl bg-[#FAF8F3] border border-[rgba(139,130,88,0.18)] text-left flex items-center gap-2.5 cursor-pointer active:scale-98 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar w-4 h-4 text-[#E06354] shrink-0\" aria-hidden=\"true\"><path d=\"M8 2v3\"></path><path d=\"M16 2v3\"></path><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"></rect><path d=\"M3 9h18\"></path></svg><div class=\"min-w-0 flex-1\"><span class=\"text-[9px] font-mono uppercase tracking-wider text-[#788E73] font-bold block truncate\">Dates</span><span class=\"text-xs font-bold block truncate text-[#788E73]\">Select Dates</span></div></button><button type=\"button\" class=\"p-2.5 rounded-xl bg-[#FAF8F3] border border-[rgba(139,130,88,0.18)] text-left flex items-center gap-2.5 cursor-pointer active:scale-98 transition-transform\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users w-4 h-4 text-[#7BA23F] shrink-0\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg><div class=\"min-w-0 flex-1\"><span class=\"text-[9px] font-mono uppercase tracking-wider text-[#788E73] font-bold block truncate\">Guests</span><span class=\"text-xs font-bold text-[#141715] block truncate\">2<!-- --> Adults</span></div></button></div><button type=\"button\" class=\"w-full py-3 rounded-xl bg-[#141715] text-[#FAF8F3] text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 shadow-sm active:scale-98 transition-transform cursor-pointer\"><span>Check Rates &amp; Available Rooms</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-[#E06354]\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></div></div></div></section><section id=\"orchard\" class=\"py-14 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto scroll-mt-20\"><div class=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 sm:mb-14 pb-6 border-b border-[rgba(139,130,88,0.2)]\"><div><div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7BA23F]/10 border border-[#7BA23F]/25 text-[#5A7E24] text-[11px] font-mono uppercase tracking-widest font-semibold mb-3\"><span class=\"w-1.5 h-1.5 rounded-full bg-[#7BA23F]\"></span><span>Slow Cadence • Saphale Foothills</span></div><h2 class=\"font-serif text-3xl sm:text-4xl lg:text-5xl text-[#141715] tracking-tight\">Curated Moments in Saphale</h2></div><p class=\"text-xs sm:text-sm text-[#56635A] max-w-md font-sans leading-relaxed\">Misty morning birdcalls, afternoon swim in natural spring waters, and unhurried coastal meals under shaded pomelo branches.</p></div><div class=\"flex items-center gap-2 sm:gap-3 overflow-x-auto pb-4 mb-8 sm:mb-10 no-scrollbar\"><button class=\"px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all duration-200 shrink-0 cursor-pointer bg-[#141715] text-[#FAF8F3] shadow-sm\">All Experiences</button><button class=\"px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all duration-200 shrink-0 cursor-pointer bg-white/80 text-[#56635A] border border-[rgba(139,130,88,0.25)] hover:border-[#141715] hover:text-[#141715]\">Spring Water Pool</button><button class=\"px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all duration-200 shrink-0 cursor-pointer bg-white/80 text-[#56635A] border border-[rgba(139,130,88,0.25)] hover:border-[#141715] hover:text-[#141715]\">12-Acre Groves</button><button class=\"px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all duration-200 shrink-0 cursor-pointer bg-white/80 text-[#56635A] border border-[rgba(139,130,88,0.25)] hover:border-[#141715] hover:text-[#141715]\">Agri Kitchen</button><button class=\"px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all duration-200 shrink-0 cursor-pointer bg-white/80 text-[#56635A] border border-[rgba(139,130,88,0.25)] hover:border-[#141715] hover:text-[#141715]\">Campfires &amp; Buyouts</button></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8\"><div class=\"group bg-white/85 rounded-2xl sm:rounded-3xl border border-[rgba(139,130,88,0.22)] overflow-hidden shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between\"><div class=\"relative w-full aspect-[16/10] sm:aspect-[16/9] overflow-hidden bg-[#F2EDE2]\"><img src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCi7vPw3FOLyDW6B-ZolyBkozWBkQORJidKhQUInUCmLJbZBMNYYTlcb-fvd56JmIMz36GDKdTJeXXFMDkERLMFGw7WtXfDkkiG6eFYDUNi7wOURNLCbk2JD6Hzu6tK52p71CZOE9f0rolm6lkdkkqvaSZtbclpQB5w4SXxSNPjHfsyBBYKSu3_9bGEofouHsFB52_d8x_CV69zmZieu2YKPPovgoY_z94If2FofMM\" alt=\"Natural Spring Swimming Pool\" data-placeholder=\"IMAGE PLACEHOLDER: Natural Spring Pool &amp; Limestone Deck\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"/><div class=\"absolute top-3.5 left-3.5 sm:top-4 sm:left-4 z-10\"><span class=\"px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider backdrop-blur-md border bg-[#38BDF8]/15 text-[#0284C7] border-[#38BDF8]/30\">Spring-Fed Water</span></div><div class=\"absolute top-3.5 right-3.5 sm:top-4 sm:right-4 z-10\"><div class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#141715]/80 backdrop-blur-md text-[#FAF8F3] text-[10px] font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path></svg><span>Open 07:00 AM to 08:00 PM</span></div></div><div class=\"absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60\"></div></div><div class=\"p-5 sm:p-7 flex-1 flex flex-col justify-between space-y-4\"><div class=\"space-y-2\"><span class=\"text-[11px] font-mono uppercase tracking-widest text-[#788E73] font-semibold block\">Spring-Fed Mountain Aquifer</span><h3 class=\"font-serif text-2xl sm:text-3xl text-[#141715] leading-tight\">Natural Spring Swimming Pool</h3><p class=\"text-xs sm:text-sm text-[#56635A] leading-relaxed pt-1\">A 65ft x 30ft natural spring water pool framed by chikoo trees and coconut palms. Limestone decks and teakwood loungers offer cool, chemical-free relaxation with pure water filtered through surrounding rock strata.</p></div><div class=\"pt-4 border-t border-[rgba(139,130,88,0.18)] flex flex-wrap items-center gap-2\"><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>65ft x 30ft Pool Basin</span></span><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Mountain Spring Source</span></span><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Shaded Chikoo Canopy</span></span></div></div></div><div class=\"group bg-white/85 rounded-2xl sm:rounded-3xl border border-[rgba(139,130,88,0.22)] overflow-hidden shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between\"><div class=\"relative w-full aspect-[16/10] sm:aspect-[16/9] overflow-hidden bg-[#F2EDE2]\"><img src=\"https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&amp;fit=crop&amp;w=1200&amp;q=80\" alt=\"12-Acre Pomelo &amp; Citrus Groves\" data-placeholder=\"IMAGE PLACEHOLDER: Pomelo Trees &amp; Orchard Walking Trails\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"/><div class=\"absolute top-3.5 left-3.5 sm:top-4 sm:left-4 z-10\"><span class=\"px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider backdrop-blur-md border bg-[#7BA23F]/15 text-[#5A7E24] border-[#7BA23F]/30\">Citrus Harvest</span></div><div class=\"absolute top-3.5 right-3.5 sm:top-4 sm:right-4 z-10\"><div class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#141715]/80 backdrop-blur-md text-[#FAF8F3] text-[10px] font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path></svg><span>Daily Morning &amp; Sunset Walks</span></div></div><div class=\"absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60\"></div></div><div class=\"p-5 sm:p-7 flex-1 flex flex-col justify-between space-y-4\"><div class=\"space-y-2\"><span class=\"text-[11px] font-mono uppercase tracking-widest text-[#788E73] font-semibold block\">Botanical Agro-Horticulture</span><h3 class=\"font-serif text-2xl sm:text-3xl text-[#141715] leading-tight\">12-Acre Pomelo &amp; Citrus Groves</h3><p class=\"text-xs sm:text-sm text-[#56635A] leading-relaxed pt-1\">Stroll along earthen irrigation canals shaded by mature citrus trees. Experience guided harvest walks, inhale fragrant white pomelo blossoms in spring, and sample sun-warmed fruit harvested directly from the branch.</p></div><div class=\"pt-4 border-t border-[rgba(139,130,88,0.18)] flex flex-wrap items-center gap-2\"><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Over 300 Citrus Trees</span></span><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Earthen Irrigation Canals</span></span><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Seasonal Tasting Walks</span></span></div></div></div><div class=\"group bg-white/85 rounded-2xl sm:rounded-3xl border border-[rgba(139,130,88,0.22)] overflow-hidden shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between\"><div class=\"relative w-full aspect-[16/10] sm:aspect-[16/9] overflow-hidden bg-[#F2EDE2]\"><img src=\"https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&amp;fit=crop&amp;w=1200&amp;q=80\" alt=\"Home-Style Agri Chulha Kitchen\" data-placeholder=\"IMAGE PLACEHOLDER: Wood-Fired Clay Chulha &amp; Hand-Pressed Bhakri\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"/><div class=\"absolute top-3.5 left-3.5 sm:top-4 sm:left-4 z-10\"><span class=\"px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider backdrop-blur-md border bg-[#E06354]/15 text-[#C0392B] border-[#E06354]/30\">Clay Hearth</span></div><div class=\"absolute top-3.5 right-3.5 sm:top-4 sm:right-4 z-10\"><div class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#141715]/80 backdrop-blur-md text-[#FAF8F3] text-[10px] font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path></svg><span>Breakfast, Lunch &amp; Chulha Dinner</span></div></div><div class=\"absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60\"></div></div><div class=\"p-5 sm:p-7 flex-1 flex flex-col justify-between space-y-4\"><div class=\"space-y-2\"><span class=\"text-[11px] font-mono uppercase tracking-widest text-[#788E73] font-semibold block\">Wood-Fired Coastal Recipes</span><h3 class=\"font-serif text-2xl sm:text-3xl text-[#141715] leading-tight\">Home-Style Agri Chulha Kitchen</h3><p class=\"text-xs sm:text-sm text-[#56635A] leading-relaxed pt-1\">Traditional clay hearth cooking using local mango and coconut timber. Enjoy piping-hot hand-pressed rice bhakri, slow-cooked gavran country chicken, fresh Surmai rawa fry, and cooling coastal solkadhi prepared with fresh coconut milk.</p></div><div class=\"pt-4 border-t border-[rgba(139,130,88,0.18)] flex flex-wrap items-center gap-2\"><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>100% Wood-Fired Cooking</span></span><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Hand-Pressed Rice Bhakri</span></span><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Fresh Coastal Surmai</span></span></div></div></div><div class=\"group bg-white/85 rounded-2xl sm:rounded-3xl border border-[rgba(139,130,88,0.22)] overflow-hidden shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between\"><div class=\"relative w-full aspect-[16/10] sm:aspect-[16/9] overflow-hidden bg-[#F2EDE2]\"><img src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuC0BFb_TtjuugqlLCRyoCMFwMzIrnaIBqpH5gUUr-tFVieMrkb7rYHAEjs8hSeigzrabwNEWtAg9pQ4fRDk_lqseeU6KYUMazmawvtYhsuahjQSbIK8pUl3m4Wwep2WuVR9x1UIZOK45haQLy2OvQULp1VqrjBzAAQ3Ex1YI0f7XeRV4VRc_tJhFGuHUrSC3XEz2R8BbXz_bVxHJzAWU7KEE0IvR8tu6fj0iESVnws\" alt=\"Starlit Campfire &amp; Exclusive Buyouts\" data-placeholder=\"IMAGE PLACEHOLDER: Campfire Nights Under Stars &amp; Verandah\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"/><div class=\"absolute top-3.5 left-3.5 sm:top-4 sm:left-4 z-10\"><span class=\"px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider backdrop-blur-md border bg-[#8B8258]/15 text-[#6B6338] border-[#8B8258]/30\">Acoustic Evenings</span></div><div class=\"absolute top-3.5 right-3.5 sm:top-4 sm:right-4 z-10\"><div class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#141715]/80 backdrop-blur-md text-[#FAF8F3] text-[10px] font-mono\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path></svg><span>Dusk to 10:30 PM</span></div></div><div class=\"absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60\"></div></div><div class=\"p-5 sm:p-7 flex-1 flex flex-col justify-between space-y-4\"><div class=\"space-y-2\"><span class=\"text-[11px] font-mono uppercase tracking-widest text-[#788E73] font-semibold block\">Sahyadri Evenings &amp; Family Celebrations</span><h3 class=\"font-serif text-2xl sm:text-3xl text-[#141715] leading-tight\">Starlit Campfire &amp; Exclusive Buyouts</h3><p class=\"text-xs sm:text-sm text-[#56635A] leading-relaxed pt-1\">As dusk blankets the orchard, gather around crackling cedar wood logs under unpolluted night skies. Reserve the entire 12-acre resort with all 5 cottages for private family reunions, milestones, or peaceful group retreats.</p></div><div class=\"pt-4 border-t border-[rgba(139,130,88,0.18)] flex flex-wrap items-center gap-2\"><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Acoustic Cedar Wood Fire</span></span><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Up to 25 Guests Buyout</span></span><span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#FAF8F3] border border-[rgba(139,130,88,0.2)] text-[11px] font-mono text-[#56635A]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-3 h-3 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Sahyadri Star Gazing</span></span></div></div></div></div><div class=\"mt-10 sm:mt-14 p-6 sm:p-8 rounded-2xl bg-[#F2EDE2]/70 border border-[rgba(139,130,88,0.25)] flex flex-col sm:flex-row items-center justify-between gap-4\"><div class=\"flex items-center gap-3\"><div class=\"w-10 h-10 rounded-full bg-white border border-[rgba(139,130,88,0.25)] flex items-center justify-center text-[#7BA23F] shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles lucide-stars w-5 h-5\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg></div><div><h4 class=\"font-serif text-base sm:text-lg text-[#141715]\">Looking to celebrate a special occasion?</h4><p class=\"text-xs text-[#56635A]\">We arrange bespoke candlelight orchard dinners, guided harvests, and custom barbecue setups.</p></div></div><a href=\"https://wa.me/919850607607?text=Hello%2C%20I%20would%20like%20to%20inquire%20about%20a%20special%20occasion%20or%20buyout%20at%20Pomelo%20Garden.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#141715] hover:bg-[#252c27] text-[#FAF8F3] text-xs uppercase tracking-wider font-semibold transition-colors shrink-0\"><span>Inquire on WhatsApp</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-3.5 h-3.5 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></section><section id=\"our-story\" class=\"py-16 sm:py-24 bg-[#F2EDE2]/60 border-y border-[rgba(139,130,88,0.2)] relative overflow-hidden scroll-mt-20\"><div class=\"absolute right-[-60px] top-1/2 -translate-y-1/2 w-96 h-96 pointer-events-none opacity-[0.04]\"><svg viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full h-full text-[#141715]\"><circle cx=\"50\" cy=\"50\" r=\"45\" stroke=\"currentColor\" stroke-width=\"2\" stroke-dasharray=\"4 4\"></circle><circle cx=\"50\" cy=\"50\" r=\"35\" stroke=\"currentColor\" stroke-width=\"1\"></circle><path d=\"M50 15 L50 85 M15 50 L85 50\" stroke=\"currentColor\" stroke-width=\"1\"></path></svg></div><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\"><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center\"><div class=\"lg:col-span-6 relative pb-12 sm:pb-8 pr-1 sm:pr-0\"><div class=\"relative rounded-3xl overflow-hidden shadow-lg border border-[rgba(139,130,88,0.25)] bg-[#FAF8F3] aspect-[4/3] group\"><img src=\"https://res.cloudinary.com/db7h39kx9/image/upload/v1795764399/unnamed_2_shegmv.webp\" alt=\"Pomelo Garden Orchard in Saphale\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\"/><div class=\"absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 p-2.5 sm:p-3 rounded-xl bg-white/90 backdrop-blur-md border border-[rgba(139,130,88,0.2)] flex items-center justify-between text-xs\"><span class=\"font-mono text-[#788E73] font-semibold text-[10px] sm:text-[11px] uppercase tracking-wider\">Saphale Agro-Horticulture</span><span class=\"font-mono text-[9px] sm:text-[10px] text-gray-500\">19.68° N, 72.82° E</span></div></div><div class=\"absolute -bottom-6 right-1 sm:-bottom-8 sm:-right-4 w-36 sm:w-56 md:w-60 rounded-xl sm:rounded-2xl bg-white p-2 sm:p-3 shadow-2xl border border-[rgba(139,130,88,0.25)] transform rotate-2 hover:rotate-0 transition-transform duration-300 z-10\"><div class=\"relative aspect-square rounded-lg sm:rounded-xl overflow-hidden bg-[#F2EDE2] mb-1.5 sm:mb-2.5\"><img src=\"https://res.cloudinary.com/db7h39kx9/image/upload/v1795765115/Suha_Pomelo_2019_bra7kh.jpg\" alt=\"Harvested Sweet Pomelo\" class=\"w-full h-full object-cover\"/><span class=\"absolute top-1.5 left-1.5 sm:top-2 sm:left-2 px-1.5 py-0.5 rounded-full bg-black/70 text-white text-[8px] sm:text-[9px] font-mono tracking-wider\">Citrus Grandis</span></div><div class=\"space-y-0.5 text-center\"><span class=\"block font-serif text-[11px] sm:text-xs font-bold text-[#141715] leading-tight\">Sweet Ruby Pomelos</span><span class=\"block text-[9px] sm:text-[10px] font-mono text-[#788E73]\">Hand-Tended With Care</span></div></div><div class=\"absolute -top-5 -left-3 sm:-left-5 w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#141715] text-[#FAF8F3] p-1.5 shadow-xl flex flex-col items-center justify-center border-2 border-[#8B8258] text-center select-none\"><span class=\"text-[8px] sm:text-[9px] font-mono uppercase tracking-widest text-[#7BA23F] font-bold\">ESTD</span><span class=\"font-serif text-sm sm:text-base font-bold text-white leading-none\">2018</span><span class=\"text-[7px] sm:text-[8px] font-mono tracking-wider text-[#FAF8F3]/75 uppercase\">Saphale</span></div></div><div class=\"lg:col-span-6 space-y-6\"><div class=\"space-y-2\"><div class=\"inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest font-semibold text-[#788E73]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sprout w-4 h-4 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3\"></path><path d=\"M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4\"></path><path d=\"M5 21h14\"></path></svg><span>The Grove Roots</span></div><h2 class=\"font-serif text-3xl sm:text-4xl lg:text-5xl text-[#141715] tracking-tight leading-tight\">Where Rare Citrus Flourishes and Time Slows Down</h2></div><div class=\"space-y-4 text-xs sm:text-sm text-[#56635A] leading-relaxed font-sans\"><p>Tucked away in the quiet agrarian hills of Saphale, just 90 minutes from Mumbai, Pomelo Garden began with a singular purpose: to preserve the authentic agricultural rhythm of the coastal Konkan belt and nurture a sanctuary where guests can experience genuine orchard serenity.</p><p>Here, there are no artificial manicured lawns or impersonal hotel corridors. Mountain spring water flows through earthen canals to nourish more than 300 citrus trees, coconut palms, and chikoo groves. Meals are cooked over slow mango wood fire, using recipes handed down through generations of coastal homesteads.</p></div><div class=\"grid grid-cols-2 gap-3 sm:gap-4 pt-2\"><div class=\"p-3.5 sm:p-4 rounded-xl bg-white/80 border border-[rgba(139,130,88,0.2)] space-y-1\"><span class=\"text-xl sm:text-2xl font-serif font-bold text-[#141715] block\">12 Acres</span><span class=\"text-[11px] font-mono text-[#788E73] font-semibold uppercase tracking-wider block\">Agro-Forestry</span><span class=\"text-[10px] text-gray-500 block leading-tight\">Zero chemical runoff or synthetic sprays</span></div><div class=\"p-3.5 sm:p-4 rounded-xl bg-white/80 border border-[rgba(139,130,88,0.2)] space-y-1\"><span class=\"text-xl sm:text-2xl font-serif font-bold text-[#141715] block\">100% Spring</span><span class=\"text-[11px] font-mono text-[#788E73] font-semibold uppercase tracking-wider block\">Mountain Aquifer</span><span class=\"text-[10px] text-gray-500 block leading-tight\">Naturally filtered spring water pool</span></div><div class=\"p-3.5 sm:p-4 rounded-xl bg-white/80 border border-[rgba(139,130,88,0.2)] space-y-1\"><span class=\"text-xl sm:text-2xl font-serif font-bold text-[#141715] block\">Clay Hearth</span><span class=\"text-[11px] font-mono text-[#788E73] font-semibold uppercase tracking-wider block\">Chulha Dining</span><span class=\"text-[10px] text-gray-500 block leading-tight\">Hand-pressed rice bhakri and fresh fish</span></div><div class=\"p-3.5 sm:p-4 rounded-xl bg-white/80 border border-[rgba(139,130,88,0.2)] space-y-1\"><span class=\"text-xl sm:text-2xl font-serif font-bold text-[#141715] block\">5 Cottages</span><span class=\"text-[11px] font-mono text-[#788E73] font-semibold uppercase tracking-wider block\">Intimate Privacy</span><span class=\"text-[10px] text-gray-500 block leading-tight\">Never crowded, always tranquil</span></div></div><div class=\"pt-4 border-t border-[rgba(139,130,88,0.2)] flex flex-col sm:flex-row sm:items-center justify-between gap-4\"><div class=\"italic text-xs text-[#56635A] max-w-sm\">&quot;We cultivated this orchard not as a commercial venture, but as our family retreat to share with guests who cherish nature, simple living, and wholesome food.&quot;</div><a class=\"inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-[#141715] hover:bg-[#252c27] text-[#FAF8F3] text-xs font-semibold uppercase tracking-wider transition-colors shrink-0\" href=\"/rooms\"><span>View Cottages</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-3.5 h-3.5 text-[#7BA23F]\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></div></section><section id=\"daily-rhythm\" class=\"py-16 sm:py-24 bg-[#FAF8F3] border-b border-[rgba(139,130,88,0.2)] scroll-mt-20 overflow-hidden relative\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\"><div class=\"text-center max-w-2xl mx-auto mb-10 sm:mb-14 space-y-3\"><div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7BA23F]/10 border border-[#7BA23F]/25 text-[#5A7E24] text-[11px] font-mono uppercase tracking-widest font-semibold\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock w-3.5 h-3.5 text-[#7BA23F]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path></svg><span>The Daily Rhythm • Slow Living</span></div><h2 class=\"font-serif text-3xl sm:text-4xl lg:text-5xl text-[#141715] tracking-tight\">A Day from Dawn to Starlight</h2><p class=\"text-xs sm:text-sm text-[#56635A] max-w-lg mx-auto leading-relaxed font-sans\">Experience how time unfolds when dictated only by the sun, the orchard breeze, and the wood-fired clay hearth.</p></div><div class=\"hidden lg:block relative\"><div class=\"relative mb-5\"><svg viewBox=\"0 0 1000 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full h-8 text-[#8B8258]\"><path d=\"M 50 16 Q 160 8, 250 16 T 450 16 T 650 16 T 850 16 T 950 16\" stroke=\"#D3C9B2\" stroke-width=\"2\" stroke-dasharray=\"4 4\"></path><path d=\"M 50 16 Q 160 8, 250 16 T 450 16 T 650 16 T 850 16 T 950 16\" stroke=\"#7BA23F\" stroke-width=\"2.5\" stroke-linecap=\"round\" class=\"transition-all duration-700\" style=\"stroke-dasharray:900;stroke-dashoffset:720\"></path><g class=\"transition-all duration-300\"><circle cx=\"100\" cy=\"16\" r=\"7\" fill=\"#7BA23F\" stroke=\"#141715\" stroke-width=\"1.5\"></circle><circle cx=\"100\" cy=\"16\" r=\"10\" stroke=\"#7BA23F\" stroke-width=\"1\" stroke-dasharray=\"2 2\"></circle></g><g class=\"transition-all duration-300\"><circle cx=\"300\" cy=\"16\" r=\"5\" fill=\"#FAF8F3\" stroke=\"#141715\" stroke-width=\"1.5\"></circle></g><g class=\"transition-all duration-300\"><circle cx=\"500\" cy=\"16\" r=\"5\" fill=\"#FAF8F3\" stroke=\"#141715\" stroke-width=\"1.5\"></circle></g><g class=\"transition-all duration-300\"><circle cx=\"700\" cy=\"16\" r=\"5\" fill=\"#FAF8F3\" stroke=\"#141715\" stroke-width=\"1.5\"></circle></g><g class=\"transition-all duration-300\"><circle cx=\"900\" cy=\"16\" r=\"5\" fill=\"#FAF8F3\" stroke=\"#141715\" stroke-width=\"1.5\"></circle></g></svg></div><div class=\"grid grid-cols-5 gap-3.5 mb-8\"><button type=\"button\" class=\"group p-4 rounded-2xl text-left transition-all duration-300 border flex flex-col justify-between cursor-pointer min-h-[170px] bg-white shadow-xl border-[#141715] scale-[1.03] ring-1 ring-[#141715]/10\"><div class=\"flex items-start justify-between gap-1 w-full mb-2\"><span class=\"font-mono text-xs font-bold text-[#141715] px-2.5 py-0.5 rounded-full bg-white/90 border border-[rgba(139,130,88,0.2)] shrink-0\">06:30 AM</span><div class=\"shrink-0 flex items-center justify-center\"><svg viewBox=\"0 0 100 80\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-16 h-14 sm:w-20 sm:h-16 transition-all duration-300 drop-shadow-sm select-none\" aria-hidden=\"true\"><defs><linearGradient id=\"desk-card-dawnSun\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#FEF08A\"></stop><stop offset=\"40%\" stop-color=\"#FBBF24\"></stop><stop offset=\"85%\" stop-color=\"#F97316\"></stop><stop offset=\"100%\" stop-color=\"#EA580C\"></stop></linearGradient><radialGradient id=\"desk-card-dawnGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\"><stop offset=\"0%\" stop-color=\"#FDE047\" stop-opacity=\"0.5\"></stop><stop offset=\"70%\" stop-color=\"#F59E0B\" stop-opacity=\"0.15\"></stop><stop offset=\"100%\" stop-color=\"#F59E0B\" stop-opacity=\"0\"></stop></radialGradient><linearGradient id=\"desk-card-dawnLeaf\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#84CC16\"></stop><stop offset=\"100%\" stop-color=\"#4D7C0F\"></stop></linearGradient></defs><style>\n              @keyframes dawnSunPulse {\n                0%, 100% { transform: scale(1); opacity: 0.95; }\n                50% { transform: scale(1.06); opacity: 1; }\n              }\n              @keyframes birdGliding {\n                0%, 100% { transform: translate(0, 0); }\n                50% { transform: translate(3px, -2px); }\n              }\n              @keyframes mistDrift {\n                0%, 100% { transform: translateX(0); opacity: 0.5; }\n                50% { transform: translateX(4px); opacity: 0.75; }\n              }\n              .anim-dawn-sun { transform-origin: 50px 32px; animation: dawnSunPulse 3.5s ease-in-out infinite; }\n              .anim-bird { animation: birdGliding 4s ease-in-out infinite; }\n              .anim-mist { animation: mistDrift 6s ease-in-out infinite; }\n            </style><circle cx=\"50\" cy=\"32\" r=\"28\" fill=\"url(#desk-card-dawnGlow)\" class=\"anim-dawn-sun\"></circle><g stroke=\"#F59E0B\" stroke-width=\"1.8\" stroke-linecap=\"round\" opacity=\"0.85\"><line x1=\"50\" y1=\"8\" x2=\"50\" y2=\"14\"></line><line x1=\"33\" y1=\"15\" x2=\"37\" y2=\"19\"></line><line x1=\"67\" y1=\"15\" x2=\"63\" y2=\"19\"></line><line x1=\"26\" y1=\"32\" x2=\"20\" y2=\"32\"></line><line x1=\"74\" y1=\"32\" x2=\"80\" y2=\"32\"></line></g><circle cx=\"50\" cy=\"32\" r=\"16\" fill=\"url(#desk-card-dawnSun)\" stroke=\"#EA580C\" stroke-width=\"1.2\" class=\"anim-dawn-sun\"></circle><circle cx=\"50\" cy=\"32\" r=\"19\" stroke=\"#FEF08A\" stroke-width=\"1\" stroke-dasharray=\"3 3\" opacity=\"0.7\"></circle><path d=\"M5 56 C20 46, 38 48, 52 42 C66 36, 80 48, 95 44\" stroke=\"#8B8258\" stroke-width=\"2.2\" stroke-linecap=\"round\" class=\"anim-mist\"></path><path d=\"M12 62 C28 54, 46 56, 62 50 C76 46, 86 54, 94 52\" stroke=\"#A89B6C\" stroke-width=\"1.5\" stroke-linecap=\"round\" opacity=\"0.6\"></path><path d=\"M10 60 C26 50, 42 46, 68 44\" stroke=\"#6B5E43\" stroke-width=\"2.4\" stroke-linecap=\"round\"></path><path d=\"M24 54 C20 42, 34 38, 42 44 C36 56, 26 56, 24 54 Z\" fill=\"url(#desk-card-dawnLeaf)\" stroke=\"#141715\" stroke-width=\"1.4\"></path><path d=\"M26 53 C31 47, 38 44, 41 44\" stroke=\"#FAF8F3\" stroke-width=\"1\" stroke-linecap=\"round\" opacity=\"0.8\"></path><circle cx=\"48\" cy=\"53\" r=\"6.5\" fill=\"#7BA23F\" stroke=\"#3F6212\" stroke-width=\"1.4\"></circle><ellipse cx=\"46.5\" cy=\"51\" rx=\"1.8\" ry=\"1\" fill=\"#FFFFFF\" opacity=\"0.6\"></ellipse><circle cx=\"36\" cy=\"46\" r=\"1.5\" fill=\"#FFFFFF\"></circle><g class=\"anim-bird\"><path d=\"M62 20 C64 16, 68 17, 71 20 C73 17, 77 16, 80 20\" stroke=\"#141715\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M74 13 C75 10, 78 11, 80 13 C82 11, 85 10, 87 13\" stroke=\"#141715\" stroke-width=\"1.2\" stroke-linecap=\"round\" opacity=\"0.8\"></path></g></svg></div></div><div><span class=\"text-[10px] font-mono uppercase tracking-widest text-[#788E73] font-bold block mb-1\">Dawn Orchard Stroll</span><h4 class=\"font-serif text-sm font-bold text-[#141715] line-clamp-2 leading-snug\">Sunrise Birdcalls &amp; Misty Citrus Groves</h4></div></button><button type=\"button\" class=\"group p-4 rounded-2xl text-left transition-all duration-300 border flex flex-col justify-between cursor-pointer min-h-[170px] bg-[#F2EDE2]/70 hover:bg-white/95 border-[rgba(139,130,88,0.22)] hover:border-[rgba(139,130,88,0.4)]\"><div class=\"flex items-start justify-between gap-1 w-full mb-2\"><span class=\"font-mono text-xs font-bold text-[#141715] px-2.5 py-0.5 rounded-full bg-white/90 border border-[rgba(139,130,88,0.2)] shrink-0\">09:30 AM</span><div class=\"shrink-0 flex items-center justify-center\"><svg viewBox=\"0 0 100 80\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-16 h-14 sm:w-20 sm:h-16 transition-all duration-300 drop-shadow-sm select-none\" aria-hidden=\"true\"><defs><linearGradient id=\"desk-card-chulhaPot\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#EA580C\"></stop><stop offset=\"50%\" stop-color=\"#C2410C\"></stop><stop offset=\"100%\" stop-color=\"#9A3412\"></stop></linearGradient><linearGradient id=\"desk-card-chulhaLog\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#78350F\"></stop><stop offset=\"100%\" stop-color=\"#451A03\"></stop></linearGradient><radialGradient id=\"desk-card-chulhaEmber\" cx=\"50%\" cy=\"50%\" r=\"50%\"><stop offset=\"0%\" stop-color=\"#F59E0B\"></stop><stop offset=\"50%\" stop-color=\"#EF4444\"></stop><stop offset=\"100%\" stop-color=\"#7C2D12\" stop-opacity=\"0\"></stop></radialGradient></defs><style>\n              @keyframes steamRise1 {\n                0% { transform: translate(0, 0) scaleX(1); opacity: 0.3; }\n                50% { transform: translate(-2px, -6px) scaleX(1.15); opacity: 0.85; }\n                100% { transform: translate(1px, -14px) scaleX(1.3); opacity: 0; }\n              }\n              @keyframes steamRise2 {\n                0% { transform: translate(0, 0) scaleX(1); opacity: 0.3; }\n                50% { transform: translate(3px, -5px) scaleX(1.1); opacity: 0.8; }\n                100% { transform: translate(-1px, -13px) scaleX(1.25); opacity: 0; }\n              }\n              @keyframes emberFlicker {\n                0%, 100% { opacity: 0.75; transform: scale(1); }\n                50% { opacity: 1; transform: scale(1.12); }\n              }\n              .anim-steam-1 { animation: steamRise1 3s ease-in-out infinite; }\n              .anim-steam-2 { animation: steamRise2 3.6s ease-in-out infinite 0.7s; }\n              .anim-ember { transform-origin: 50px 65px; animation: emberFlicker 2s ease-in-out infinite; }\n            </style><g stroke=\"#A89B6C\" stroke-width=\"1.6\" stroke-linecap=\"round\"><path d=\"M44 26 C40 20, 48 16, 44 10 C42 6, 46 4, 43 0\" class=\"anim-steam-1\"></path><path d=\"M56 25 C52 19, 60 15, 56 9 C54 5, 58 3, 55 0\" class=\"anim-steam-2\"></path></g><g><rect x=\"16\" y=\"60\" width=\"68\" height=\"10\" rx=\"5\" transform=\"rotate(-12 50 65)\" fill=\"url(#desk-card-chulhaLog)\" stroke=\"#141715\" stroke-width=\"1.8\"></rect><rect x=\"16\" y=\"60\" width=\"68\" height=\"10\" rx=\"5\" transform=\"rotate(12 50 65)\" fill=\"#92400E\" stroke=\"#141715\" stroke-width=\"1.8\"></rect><circle cx=\"21\" cy=\"62\" r=\"3.2\" fill=\"#B45309\" stroke=\"#141715\" stroke-width=\"1\"></circle><circle cx=\"21\" cy=\"62\" r=\"1.5\" fill=\"#78350F\"></circle></g><circle cx=\"50\" cy=\"64\" r=\"14\" fill=\"url(#desk-card-chulhaEmber)\" class=\"anim-ember\"></circle><circle cx=\"42\" cy=\"63\" r=\"3.2\" fill=\"#F59E0B\"></circle><circle cx=\"58\" cy=\"62\" r=\"3\" fill=\"#EF4444\"></circle><circle cx=\"50\" cy=\"61\" r=\"3.6\" fill=\"#FDE047\"></circle><path d=\"M26 40 C26 31, 35 27, 50 27 C65 27, 74 31, 74 40 C74 56, 64 59, 50 59 C36 59, 26 56, 26 40 Z\" fill=\"url(#desk-card-chulhaPot)\" stroke=\"#141715\" stroke-width=\"2.2\"></path><ellipse cx=\"50\" cy=\"31\" rx=\"20\" ry=\"5.5\" fill=\"#C2410C\" stroke=\"#141715\" stroke-width=\"1.8\"></ellipse><ellipse cx=\"50\" cy=\"30\" rx=\"14\" ry=\"3.5\" fill=\"#EA580C\" stroke=\"#141715\" stroke-width=\"1.2\"></ellipse><circle cx=\"50\" cy=\"25\" r=\"3\" fill=\"#7C2D12\" stroke=\"#141715\" stroke-width=\"1.2\"></circle><path d=\"M32 40 C32 35, 38 33, 44 33\" stroke=\"#FEF08A\" stroke-width=\"1.2\" stroke-linecap=\"round\" opacity=\"0.6\"></path></svg></div></div><div><span class=\"text-[10px] font-mono uppercase tracking-widest text-[#788E73] font-bold block mb-1\">Clay Chulha Hearth Breakfast</span><h4 class=\"font-serif text-sm font-bold text-[#141715] line-clamp-2 leading-snug\">Hand-Pressed Rice Bhakri &amp; Slow-Brewed Tea</h4></div></button><button type=\"button\" class=\"group p-4 rounded-2xl text-left transition-all duration-300 border flex flex-col justify-between cursor-pointer min-h-[170px] bg-[#F2EDE2]/70 hover:bg-white/95 border-[rgba(139,130,88,0.22)] hover:border-[rgba(139,130,88,0.4)]\"><div class=\"flex items-start justify-between gap-1 w-full mb-2\"><span class=\"font-mono text-xs font-bold text-[#141715] px-2.5 py-0.5 rounded-full bg-white/90 border border-[rgba(139,130,88,0.2)] shrink-0\">01:30 PM</span><div class=\"shrink-0 flex items-center justify-center\"><svg viewBox=\"0 0 100 80\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-16 h-14 sm:w-20 sm:h-16 transition-all duration-300 drop-shadow-sm select-none\" aria-hidden=\"true\"><defs><linearGradient id=\"desk-card-waveGrad1\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#38BDF8\"></stop><stop offset=\"50%\" stop-color=\"#0284C7\"></stop><stop offset=\"100%\" stop-color=\"#0369A1\"></stop></linearGradient><linearGradient id=\"desk-card-waveGrad2\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#7DD3FC\"></stop><stop offset=\"100%\" stop-color=\"#38BDF8\"></stop></linearGradient><linearGradient id=\"desk-card-palmGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#65A30D\"></stop><stop offset=\"100%\" stop-color=\"#365314\"></stop></linearGradient></defs><style>\n              @keyframes waveOscillation {\n                0%, 100% { transform: translateX(0); }\n                50% { transform: translateX(3px); }\n              }\n              @keyframes waveOscillationRev {\n                0%, 100% { transform: translateX(0); }\n                50% { transform: translateX(-3px); }\n              }\n              @keyframes palmSwaying {\n                0%, 100% { transform: rotate(0deg); }\n                50% { transform: rotate(-2.5deg); }\n              }\n              .anim-wave-1 { animation: waveOscillation 4s ease-in-out infinite; }\n              .anim-wave-2 { animation: waveOscillationRev 3.5s ease-in-out infinite; }\n              .anim-palm { transform-origin: 20px 18px; animation: palmSwaying 5s ease-in-out infinite; }\n            </style><path d=\"M10 40 L90 40\" stroke=\"#D3C9B2\" stroke-width=\"4\" stroke-linecap=\"round\"></path><line x1=\"32\" y1=\"38\" x2=\"32\" y2=\"42\" stroke=\"#8B8258\" stroke-width=\"1.5\"></line><line x1=\"68\" y1=\"38\" x2=\"68\" y2=\"42\" stroke=\"#8B8258\" stroke-width=\"1.5\"></line><path d=\"M12 50 C24 43, 36 55, 50 49 C64 43, 76 55, 88 48\" stroke=\"url(#desk-card-waveGrad1)\" stroke-width=\"3.6\" stroke-linecap=\"round\" class=\"anim-wave-1\"></path><path d=\"M16 60 C28 53, 40 65, 52 58 C64 51, 74 63, 84 57\" stroke=\"#0369A1\" stroke-width=\"2.8\" stroke-linecap=\"round\" opacity=\"0.85\" class=\"anim-wave-2\"></path><circle cx=\"36\" cy=\"47\" r=\"1.8\" fill=\"#FFFFFF\" opacity=\"0.9\"></circle><circle cx=\"64\" cy=\"46\" r=\"2.2\" fill=\"#FFFFFF\" opacity=\"0.9\"></circle><circle cx=\"48\" cy=\"56\" r=\"1.5\" fill=\"#7DD3FC\"></circle><g class=\"anim-palm\"><path d=\"M16 16 C32 16, 52 26, 62 36\" stroke=\"#141715\" stroke-width=\"2.4\" stroke-linecap=\"round\"></path><path d=\"M26 15 C24 6, 38 7, 42 16 Z\" fill=\"url(#desk-card-palmGrad)\" stroke=\"#141715\" stroke-width=\"1.2\"></path><path d=\"M38 18 C38 9, 52 11, 54 21 Z\" fill=\"#65A30D\" stroke=\"#141715\" stroke-width=\"1.2\"></path><path d=\"M48 24 C50 16, 62 18, 62 28 Z\" fill=\"#84CC16\" stroke=\"#141715\" stroke-width=\"1.2\"></path><path d=\"M20 18 C14 12, 16 6, 24 9 Z\" fill=\"#4D7C0F\" stroke=\"#141715\" stroke-width=\"1\"></path></g></svg></div></div><div><span class=\"text-[10px] font-mono uppercase tracking-widest text-[#788E73] font-bold block mb-1\">Spring Pool Plunge &amp; Siesta</span><h4 class=\"font-serif text-sm font-bold text-[#141715] line-clamp-2 leading-snug\">Mountain Aquifer Swim &amp; Shaded Teak Loungers</h4></div></button><button type=\"button\" class=\"group p-4 rounded-2xl text-left transition-all duration-300 border flex flex-col justify-between cursor-pointer min-h-[170px] bg-[#F2EDE2]/70 hover:bg-white/95 border-[rgba(139,130,88,0.22)] hover:border-[rgba(139,130,88,0.4)]\"><div class=\"flex items-start justify-between gap-1 w-full mb-2\"><span class=\"font-mono text-xs font-bold text-[#141715] px-2.5 py-0.5 rounded-full bg-white/90 border border-[rgba(139,130,88,0.2)] shrink-0\">05:30 PM</span><div class=\"shrink-0 flex items-center justify-center\"><svg viewBox=\"0 0 100 80\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-16 h-14 sm:w-20 sm:h-16 transition-all duration-300 drop-shadow-sm select-none\" aria-hidden=\"true\"><defs><linearGradient id=\"desk-card-sunsetSun\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#F59E0B\"></stop><stop offset=\"60%\" stop-color=\"#EA580C\"></stop><stop offset=\"100%\" stop-color=\"#E06354\"></stop></linearGradient><linearGradient id=\"desk-card-solkadhiLiquid\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#F47A6B\"></stop><stop offset=\"70%\" stop-color=\"#E06354\"></stop><stop offset=\"100%\" stop-color=\"#BD4335\"></stop></linearGradient><linearGradient id=\"desk-card-earthenCup\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#D97706\"></stop><stop offset=\"100%\" stop-color=\"#92400E\"></stop></linearGradient></defs><style>\n              @keyframes sunsetSunGlow {\n                0%, 100% { transform: scale(1); opacity: 0.9; }\n                50% { transform: scale(1.05); opacity: 1; }\n              }\n              .anim-sunset-sun { transform-origin: 65px 32px; 