"font-mono text-xs font-bold text-[#141715] px-2.5 py-0.5 rounded-full bg-white/90 border border-[rgba(139,130,88,0.2)] shrink-0\">08:30 PM</span><div class=\"shrink-0 flex items-center justify-center\"><svg viewBox=\"0 0 100 80\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-16 h-14 sm:w-20 sm:h-16 transition-all duration-300 drop-shadow-sm select-none\" aria-hidden=\"true\"><defs><linearGradient id=\"desk-card-fireOuter\" x1=\"0%\" y1=\"100%\" x2=\"0%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#B91C1C\"></stop><stop offset=\"40%\" stop-color=\"#EA580C\"></stop><stop offset=\"85%\" stop-color=\"#F59E0B\"></stop><stop offset=\"100%\" stop-color=\"#FDE047\"></stop></linearGradient><linearGradient id=\"desk-card-fireInner\" x1=\"0%\" y1=\"100%\" x2=\"0%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#F59E0B\"></stop><stop offset=\"60%\" stop-color=\"#FDE047\"></stop><stop offset=\"100%\" stop-color=\"#FFFFFF\"></stop></linearGradient></defs><style>\n              @keyframes flameFlickering {\n                0%, 100% { transform: scale(1) rotate(0deg); }\n                25% { transform: scale(1.04, 0.97) rotate(-1.5deg); }\n                50% { transform: scale(0.97, 1.05) rotate(1.5deg); }\n                75% { transform: scale(1.02, 1.01) rotate(-0.5deg); }\n              }\n              @keyframes starTwinkling {\n                0%, 100% { opacity: 0.35; transform: scale(0.85); }\n                50% { opacity: 1; transform: scale(1.25); }\n              }\n              @keyframes emberFloating {\n                0% { transform: translate(0, 0); opacity: 0.9; }\n                50% { transform: translate(-3px, -8px); opacity: 1; }\n                100% { transform: translate(2px, -18px); opacity: 0; }\n              }\n              .anim-flame { transform-origin: 50px 60px; animation: flameFlickering 2.2s ease-in-out infinite; }\n              .anim-star-1 { transform-origin: 22px 14px; animation: starTwinkling 2.5s ease-in-out infinite; }\n  